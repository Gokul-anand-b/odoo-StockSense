# ==========================================
# StockSense Environment Configuration
# ==========================================

# Django Backend Settings
DEBUG=True
SECRET_KEY=stocksense-insecure-hackathon-development-key-2025
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Option A: Cloud Shared Database (Recommended for Teams - e.g. Neon, Supabase, Render)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/stocksense_db?sslmode=require

# Option B: Local PostgreSQL (or fallback to SQLite when DATABASE_URL is not set)
DB_NAME=stocksense_db
DB_USER=stocksense_user
DB_PASSWORD=stocksense_secure_pass
DB_HOST=localhost
DB_PORT=5432

# Redis & Channels (WebSocket)
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# JWT Auth
JWT_SECRET_KEY=stocksense-jwt-super-secret-key-32chars
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Email / OTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=admin@stocksense.io
EMAIL_HOST_PASSWORD=samplepassword

# Frontend Next.js Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=StockSense
